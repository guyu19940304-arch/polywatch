    "start": "node scripts/run.mjs --production",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {"react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0", "recharts": "^3.0.0"},
